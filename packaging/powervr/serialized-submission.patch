+/* Timestamp markers use the firmware's GPU-to-host clock correlation.
+ * Rebase at each marker to account for power cycles and the current OPP.
+ */
+static void pvr_queue_write_timestamp(struct pvr_job *job, struct pvr_cccb *cccb)
+{
+	struct pvr_device *dev = job->pvr_dev;
+	struct pvr_fw_object *obj = dev->fw_dev.mem.gpu_util_fwcb_obj;
+	struct rogue_fwif_gpu_util_fwcb *util = pvr_fw_object_vmap(obj);
+	u32 address[2] = {};
 
+	if (!IS_ERR(util)) {
+		u32 rate = clk_get_rate(dev->core_clk);
+
+		if (rate) {
+			/* Separate context schedulers can publish markers concurrently. */
+			mutex_lock(&dev->queues.lock);
+			u32 seq = READ_ONCE(util->time_corr_seq_count) + 1;
+			struct rogue_fwif_time_corr *corr =
+				&util->time_corr[ROGUE_FWIF_TIME_CORR_CURR_INDEX(seq)];
+			u64 cr = pvr_cr_read64(dev, ROGUE_CR_TIMER) & ~ROGUE_CR_TIMER_VALUE_CLRMSK;
+			u64 ns = ktime_get_ns();
+
+			WRITE_ONCE(corr->os_timestamp, ns);
+			WRITE_ONCE(corr->os_mono_timestamp, ns);
+			WRITE_ONCE(corr->cr_timestamp, cr);
+			WRITE_ONCE(corr->cr_delta_to_os_delta_kns,
+				   div_u64(((u64)ROGUE_CRTIME_TICK_IN_CYCLES * NSEC_PER_SEC) << 20,
+					   rate));
+			WRITE_ONCE(corr->core_clock_speed, rate);
+			dma_wmb();
+			WRITE_ONCE(util->time_corr_seq_count, seq);
+			mutex_unlock(&dev->queues.lock);
+		}
+		pvr_fw_object_vunmap(obj);
+	}
+	pvr_fw_object_get_fw_addr(job->timestamp_obj, &address[0]);
+	pvr_cccb_write_command_with_header(cccb, ROGUE_FWIF_CCB_CMD_TYPE_POST_TIMESTAMP,
+					   sizeof(address), address, job->id, job->id);
+}
