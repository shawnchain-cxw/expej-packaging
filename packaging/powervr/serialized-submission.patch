 static int
+pvr_timestamp_job_init(struct pvr_job *job, struct pvr_file *file,
+		       const struct drm_pvr_job *args)
+{
+	u32 stream[2];
+
+	if (job->ctx->type != DRM_PVR_CTX_TYPE_COMPUTE ||
+	    args->cmd_stream_len != sizeof(stream))
+		return -EINVAL;
+	if (copy_from_user(stream, u64_to_user_ptr(args->cmd_stream), sizeof(stream)))
+		return -EFAULT;
+	if (stream[1])
+		return -EINVAL;
+	job->timestamp_dst = pvr_gem_object_from_handle(file, stream[0]);
+	if (!job->timestamp_dst ||
+	    !(job->timestamp_dst->flags & DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS))
+		return -EINVAL;
+	job->timestamp_dst_map = pvr_gem_object_vmap(job->timestamp_dst);
+	if (IS_ERR(job->timestamp_dst_map)) {
+		int ret = PTR_ERR(job->timestamp_dst_map);
+
+		job->timestamp_dst_map = NULL;
+		return ret;
+	}
+
+	job->timestamp = pvr_fw_object_create_and_map(job->pvr_dev, sizeof(*job->timestamp),
+						      PVR_BO_FW_FLAGS_DEVICE_UNCACHED,
+						      NULL, NULL, &job->timestamp_obj);
+	if (IS_ERR(job->timestamp))
+		return PTR_ERR(job->timestamp);
+	WRITE_ONCE(*job->timestamp, 0);
+	job->fw_ccb_cmd_type = ROGUE_FWIF_CCB_CMD_TYPE_NULL;
+	return 0;
+}
