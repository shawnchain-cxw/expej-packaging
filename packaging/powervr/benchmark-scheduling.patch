 static int
+pvr_timestamp_map_dst(struct pvr_file *file, u32 handle, u32 offset,
+		      size_t size, struct pvr_gem_object **obj_out, void **map_out)
+{
+	struct pvr_gem_object *obj = pvr_gem_object_from_handle(file, handle);
+	void *mapping;
+	int err;
+
+	if (!obj)
+		return -EINVAL;
+	if (!(obj->flags & DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS) ||
+	    !IS_ALIGNED(offset, size) || (u64)offset + size > pvr_gem_object_size(obj)) {
+		err = -EINVAL;
+		goto err_put;
+	}
+
+	mapping = pvr_gem_object_vmap(obj);
+	if (IS_ERR(mapping)) {
+		err = PTR_ERR(mapping);
+		goto err_put;
+	}
+
+	*obj_out = obj;
+	*map_out = (u8 *)mapping + offset;
+	return 0;
+
+err_put:
+	pvr_gem_object_put(obj);
+	return err;
+}
