 }
 
+/* Runtime PM serializes the callbacks. Probe's additional call runs under
+ * a runtime reference before the DRM device is published.
+ */
+int pvr_power_hold_a733_parent(struct pvr_device *pvr_dev)
+{
+	int err;
+
+	if (!pvr_dev->a733_parent_clk || pvr_dev->a733_parent_held)
+		return 0;
+
+	err = clk_prepare_enable(pvr_dev->a733_parent_clk);
+	if (!err)
+		pvr_dev->a733_parent_held = true;
+	return err;
+}
+
+static void pvr_power_drop_a733_parent(void *data)
+{
+	struct pvr_device *pvr_dev = data;
+
+	if (pvr_dev->a733_parent_held) {
+		clk_disable_unprepare(pvr_dev->a733_parent_clk);
+		pvr_dev->a733_parent_held = false;
+	}
+}
+
+int pvr_power_init_a733_parent(struct pvr_device *pvr_dev)
+{
+	struct device *dev = from_pvr_device(pvr_dev)->dev;
+	struct clk *clk;
+
+	if (!of_device_is_compatible(dev->of_node, "img,gpu") ||
+	    !of_machine_is_compatible("radxa,cubie-a7a"))
+		return 0;
+
+	clk = devm_clk_get(dev, "clk_parent");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get GPU clk_parent\n");
+
+	pvr_dev->a733_parent_clk = clk;
+	return devm_add_action_or_reset(dev, pvr_power_drop_a733_parent, pvr_dev);
+}
+
